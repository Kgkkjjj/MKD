import sys
from fs import read_file
from cli import require_args

USAGE = "Usage: wc.pyoc <file>"


def main(argv):
    """Count lines, words and bytes of a file."""
    if not require_args(argv, 1, USAGE):
        return
    text = read_file(argv[1])
    lines = text.splitlines()
    words = text.split()
    print(f"{len(lines)} {len(words)} {len(text)}")


if __name__ == '__main__':
    main(sys.argv)
