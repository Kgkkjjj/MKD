import sys
from fs import make_dir
from args import parse as parse_args
from log import log


def main(argv):
    opts, positional = parse_args(argv[1:])
    if not positional:
        print(f"Usage: {argv[0]} <directory> [--log]")
        return
    directory = positional[0]
    make_dir(directory)
    if opts.get('log'):
        log(f"Created {directory}")


if __name__ == "__main__":
    main(sys.argv)
