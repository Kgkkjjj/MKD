import sys
from fs import make_dir
from args import parse as parse_args
from log import log
from time_utils import current_timestamp
from os_utils import path_join


def main(argv):
    opts, positional = parse_args(argv[1:])
    if not positional:
        print(f"Usage: {argv[0]} <directory> [--log]")
        return
    directory = positional[0]
    make_dir(directory)
    if opts.get('log'):
        ts = current_timestamp()
        log(f"[{ts}] Created {directory}")
    if opts.get('join'):
        joined = path_join(directory, opts.get('join'))
        print(joined)


if __name__ == "__main__":
    main(sys.argv)
