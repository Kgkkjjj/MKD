# Demo script for the extended Systx language
rand 10 r
print "Random number:" r

argc argcount
print "Arg count:" argcount
arg 0 self
print "Script name:" self
envget HOME home
print "Home:" home

call factorial 5
print "Factorial:" result

set text "hello,world"
split text "," parts
get parts 0 first
upper first first_upper
append parts "python"
lenlist parts count
join parts "-" joined
print "Joined:" joined
print "First upper:" first_upper
print "Count:" count

open "demo.txt" "w" fh
write fh joined
write fh "\n"
close fh
readfile "demo.txt" contents
print "File:" contents
gui_init "Demo"
gui_label gui_root "Hello"
gui_button gui_root "Quit" quit
gui_start gui_root
exit

func quit
gui_quit gui_root
return
end

func factorial n
set result 1
while n > 1
    mul result n result
    dec n
endwhile
setg result result
return
end
