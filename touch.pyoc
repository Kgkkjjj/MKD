import sys
import os
from cli import require_args

USAGE = "Usage: touch.pyoc <file>"


def main(argv):
    """Create a file if missing or update its timestamp."""
    if not require_args(argv, 1, USAGE):
        return
    path = argv[1]
    with open(path, 'a'):
        os.utime(path, None)


if __name__ == '__main__':
    main(sys.argv)
