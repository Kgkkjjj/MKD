import sys
import os


def main(argv):
    """Create a file if missing or update its timestamp."""
    if len(argv) < 2:
        print(f"Usage: {argv[0]} <file>")
        return
    path = argv[1]
    with open(path, 'a'):
        os.utime(path, None)


if __name__ == '__main__':
    main(sys.argv)
