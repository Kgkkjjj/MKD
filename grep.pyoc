import sys
from fs import read_file
from cli import require_args

USAGE = "Usage: grep.pyoc <pattern> <file>"


def main(argv):
    """Search a file for a substring and print matching lines."""
    if not require_args(argv, 2, USAGE):
        return
    pattern = argv[1]
    lines = read_file(argv[2]).splitlines()
    for line in lines:
        if pattern in line:
            print(line)


if __name__ == '__main__':
    main(sys.argv)
