import time


def log(message: str) -> None:
    ts = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime())
    print(f'[{ts}] {message}')


def error(message: str) -> None:
    ts = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime())
    import sys
    print(f'[ERROR {ts}] {message}', file=sys.stderr)
