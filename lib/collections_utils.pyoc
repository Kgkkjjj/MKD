def unique_list(items):
    seen = set()
    result = []
    for item in items:
        if item not in seen:
            seen.add(item)
            result.append(item)
    return result


def chunk_list(items, size):
    """Yield successive chunks from items of length ``size``."""
    for i in range(0, len(items), size):
        yield items[i:i + size]
