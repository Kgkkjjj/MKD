"""Simple file locking utilities."""

import os
import time

try:
    import fcntl
    HAS_FCNTL = True
except ImportError:
    HAS_FCNTL = False


def lock(path: str):
    f = open(path, 'a+')
    if HAS_FCNTL:
        fcntl.flock(f, fcntl.LOCK_EX)
    return f


def unlock(f):
    if HAS_FCNTL:
        fcntl.flock(f, fcntl.LOCK_UN)
    f.close()
