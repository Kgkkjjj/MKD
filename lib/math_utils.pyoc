def add(a, b):
    return a + b


def subtract(a, b):
    return a - b


def multiply(a, b):
    return a * b


def divide(a, b):
    return a / b


def power(a, b):
    return a ** b


def modulus(a, b):
    return a % b


def average(values):
    return sum(values) / len(values) if values else 0


def factorial(n):
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result
