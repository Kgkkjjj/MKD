"""Encoding and decoding helpers."""

import base64
import codecs
from urllib.parse import quote, unquote


def to_base64(data: bytes) -> str:
    return base64.b64encode(data).decode('ascii')


def from_base64(data: str) -> bytes:
    return base64.b64decode(data.encode('ascii'))


def hex_encode(data: bytes) -> str:
    return data.hex()


def hex_decode(hex_str: str) -> bytes:
    return bytes.fromhex(hex_str)


def to_base16(data: bytes) -> str:
    return base64.b16encode(data).decode('ascii')


def from_base16(data: str) -> bytes:
    return base64.b16decode(data.encode('ascii'))


def to_base32(data: bytes) -> str:
    return base64.b32encode(data).decode('ascii')


def from_base32(data: str) -> bytes:
    return base64.b32decode(data.encode('ascii'))


def to_base85(data: bytes) -> str:
    return base64.b85encode(data).decode('ascii')


def from_base85(data: str) -> bytes:
    return base64.b85decode(data.encode('ascii'))


def to_ascii85(data: bytes) -> str:
    return base64.a85encode(data).decode('ascii')


def from_ascii85(data: str) -> bytes:
    return base64.a85decode(data.encode('ascii'))


def to_urlsafe_base64(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).decode('ascii')


def from_urlsafe_base64(data: str) -> bytes:
    return base64.urlsafe_b64decode(data.encode('ascii'))


def to_utf8(text: str) -> bytes:
    return text.encode('utf-8')


def from_utf8(data: bytes) -> str:
    return data.decode('utf-8')


def to_utf16(text: str) -> bytes:
    return text.encode('utf-16')


def from_utf16(data: bytes) -> str:
    return data.decode('utf-16')


def to_utf32(text: str) -> bytes:
    return text.encode('utf-32')


def from_utf32(data: bytes) -> str:
    return data.decode('utf-32')


def to_ascii(text: str) -> bytes:
    return text.encode('ascii')


def from_ascii(data: bytes) -> str:
    return data.decode('ascii')


def to_latin1(text: str) -> bytes:
    return text.encode('latin-1')


def from_latin1(data: bytes) -> str:
    return data.decode('latin-1')


def rot13(text: str) -> str:
    return codecs.encode(text, 'rot_13')


def url_encode(text: str) -> str:
    return quote(text)


def url_decode(text: str) -> str:
    return unquote(text)
