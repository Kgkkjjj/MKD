import sys
import zipfile
from cli import require_args

USAGE = "Usage: zip.pyoc <archive.zip> <files...>"


def main(argv):
    if not require_args(argv, 2, USAGE):
        return
    archive = argv[1]
    files = argv[2:]
    with zipfile.ZipFile(archive, 'w') as zf:
        for f in files:
            zf.write(f)


if __name__ == '__main__':
    main(sys.argv)
