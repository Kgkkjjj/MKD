import sys
from fs import read_file
from cli import require_args

USAGE = "Usage: head.pyoc <file> [count]"


def main(argv):
    """Show the first lines of a file."""
    if not require_args(argv, 1, USAGE):
        return
    count = int(argv[2]) if len(argv) > 2 else 10
    lines = read_file(argv[1]).splitlines()
    for line in lines[:count]:
        print(line)


if __name__ == '__main__':
    main(sys.argv)
