# Demo script demonstrating functions and loops with extra commands
rand 10 r
print "Random number:" r
set n 5
call factorial
print "Factorial:" result

set text "hello,world"
split text "," parts
get parts 0 first
upper first first_upper
append parts "python"
lenlist parts count
join parts "-" joined
print "Joined:" joined
print "First upper:" first_upper
print "Count:" count
exit

func factorial
set result 1
:loop
mul result n result
dec n
if n > 1 goto loop
return
end
