# Demo script for the extended Systx language
rand 10 r
print "Random number:" r

call factorial 5
print "Factorial:" result

set text "hello,world"
split text "," parts
get parts 0 first
upper first first_upper
append parts "python"
lenlist parts count
join parts "-" joined
print "Joined:" joined
print "First upper:" first_upper
print "Count:" count

open "demo.txt" "w" fh
write fh joined
write fh "\n"
close fh
exit

func factorial n
set result 1
while n > 1
    mul result n result
    dec n
endwhile
setg result result
return
end
