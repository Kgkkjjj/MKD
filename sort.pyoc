import sys
from cli import require_args
from fs import read_file

USAGE = "Usage: sort.pyoc <file>"


def main(argv):
    """Sort the lines of a file and print them."""
    if not require_args(argv, 1, USAGE):
        return
    lines = read_file(argv[1]).splitlines()
    for line in sorted(lines):
        print(line)


if __name__ == '__main__':
    main(sys.argv)
